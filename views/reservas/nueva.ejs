<h2>Nueva reserva</h2>

<% if (error) { %>
  <div class="alerta" role="alert"><%= error %></div>
<% } %>

<form action="/reservas" method="POST">
  <label for="estudiante">Estudiante</label>
  <input id="estudiante" name="estudiante" type="text" value="<%= valores.estudiante || '' %>" required>

  <label for="email">Email</label>
  <input id="email" name="email" type="email" value="<%= valores.email || '' %>" required>

  <label for="sala">Sala</label>
  <select id="sala" name="sala" required>
    <option value="">Seleccionar</option>
    <% salasPermitidas.forEach(sala => { %>
      <option value="<%= sala %>" <%= valores.sala === sala ? "selected" : "" %>><%= sala %></option>
    <% }) %>
  </select>

  <label for="fecha">Fecha</label>
  <input id="fecha" name="fecha" type="date" value="<%= valores.fecha || '' %>" required>

  <label for="turno">Turno</label>
  <select id="turno" name="turno" required>
    <option value="">Seleccionar</option>
    <% turnosPermitidos.forEach(turno => { %>
      <option value="<%= turno %>" <%= valores.turno === turno ? "selected" : "" %>><%= turno %></option>
    <% }) %>
  </select>

  <label for="personas">Cantidad de personas</label>
  <input id="personas" name="personas" type="number" min="1" max="6" value="<%= valores.personas || '' %>" required>

  <button type="submit">Guardar reserva</button>
</form>